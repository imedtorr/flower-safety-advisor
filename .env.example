GIGACHAT_CREDENTIALS=your_gigachat_authorization_key
# Модель для распознавания фото (нужен доступ к vision, по умолчанию GigaChat-Pro)
GIGACHAT_VISION_MODEL=GigaChat-Pro
TAVILY_API_KEY=your_tavily_api_key
PORT=3001

# LangSmith (https://smith.langchain.com) — опционально, для трассировки LangGraph
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=flower-safety-advisor
